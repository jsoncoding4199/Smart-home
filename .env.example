# Leave AQARA_APP_ID empty to run in demo mode with simulated devices.
# Get these from the Aqara Developer Platform (https://developer.aqara.com) -> Project -> App.
AQARA_APP_ID=
AQARA_APP_KEY=
AQARA_KEY_ID=
# cn | usa | eu | kr | ru | sg
AQARA_REGION=usa
# Aqara account (phone or email) the app controls; used for the auth-code login flow.
AQARA_ACCOUNT=
# Optional: paste tokens directly instead of using the in-app login.
AQARA_ACCESS_TOKEN=
AQARA_REFRESH_TOKEN=

PORT=3000
HOST=0.0.0.0
# Optional: require this token (Authorization: Bearer <token>) for /api calls.
DASHBOARD_TOKEN=
